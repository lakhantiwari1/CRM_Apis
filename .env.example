# Server Configuration
NODE_ENV=development
PORT=5000

# MongoDB Configuration
MONGODB_URI=mongodb://localhost:27017/crm_sales_db

# JWT Configuration
JWT_ACCESS_SECRET=your_super_secure_jwt_access_secret_key_here_min_32_chars
JWT_REFRESH_SECRET=your_super_secure_jwt_refresh_secret_key_here_min_32_chars
JWT_ACCESS_EXPIRE=15m
JWT_REFRESH_EXPIRE=7d

# Cookie Configuration
COOKIE_SECRET=your_cookie_secret_key_here

# CORS Configuration
CLIENT_URL=http://localhost:3000

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Bcrypt
BCRYPT_SALT_ROUNDS=12
