{
  "info": {
    "_postman_id": "crm-sales-api-collection",
    "name": "CRM Sales Management API",
    "description": "Complete Postman collection for CRM Sales Management System. \n\n## Setup\n1. Import this collection\n2. Set `baseUrl` variable to `http://localhost:5000/api`\n3. Run 'Login' request first — token auto-saves\n4. All protected routes use `{{accessToken}}` variable automatically",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "https://crm-sales-api.onrender.com/api", "type": "string" },
    { "key": "accessToken", "value": "", "type": "string" },
    { "key": "leadId", "value": "", "type": "string" },
    { "key": "customerId", "value": "", "type": "string" },
    { "key": "dealId", "value": "", "type": "string" },
    { "key": "activityId", "value": "", "type": "string" },
    { "key": "userId", "value": "", "type": "string" }
  ],
  "auth": {
    "type": "bearer",
    "bearer": [{ "key": "token", "value": "{{accessToken}}", "type": "string" }]
  },
  "item": [
    {
      "name": "🔒 Authentication",
      "item": [
        {
          "name": "Register User",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/auth/register",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"John Admin\",\n  \"email\": \"admin@crm.com\",\n  \"password\": \"Admin@123\",\n  \"phone\": \"+1234567890\",\n  \"role\": \"admin\"\n}"
            }
          },
          "event": [{
            "listen": "test",
            "script": {
              "exec": [
                "if (pm.response.code === 201) {",
                "  const res = pm.response.json();",
                "  pm.collectionVariables.set('accessToken', res.data.accessToken);",
                "  console.log('Token saved:', res.data.accessToken);",
                "}"
              ]
            }
          }]
        },
        {
          "name": "Login — Admin",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/auth/login",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"admin@crm.com\",\n  \"password\": \"Admin@123\"\n}"
            }
          },
          "event": [{
            "listen": "test",
            "script": {
              "exec": [
                "if (pm.response.code === 200) {",
                "  const res = pm.response.json();",
                "  pm.collectionVariables.set('accessToken', res.data.accessToken);",
                "  console.log('Logged in as Admin');",
                "}"
              ]
            }
          }]
        },
        {
          "name": "Login — Sales Manager",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/auth/login",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"manager@crm.com\",\n  \"password\": \"Manager@123\"\n}"
            }
          },
          "event": [{
            "listen": "test",
            "script": {
              "exec": [
                "if (pm.response.code === 200) {",
                "  const res = pm.response.json();",
                "  pm.collectionVariables.set('accessToken', res.data.accessToken);",
                "}"
              ]
            }
          }]
        },
        {
          "name": "Login — Sales Executive",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/auth/login",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"executive@crm.com\",\n  \"password\": \"Executive@123\"\n}"
            }
          },
          "event": [{
            "listen": "test",
            "script": {
              "exec": [
                "if (pm.response.code === 200) {",
                "  const res = pm.response.json();",
                "  pm.collectionVariables.set('accessToken', res.data.accessToken);",
                "}"
              ]
            }
          }]
        },
        {
          "name": "Get My Profile",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/auth/me"
          }
        },
        {
          "name": "Update My Profile",
          "request": {
            "method": "PATCH",
            "url": "{{baseUrl}}/auth/me",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Updated Name\",\n  \"phone\": \"+9876543210\"\n}"
            }
          }
        },
        {
          "name": "Change Password",
          "request": {
            "method": "PATCH",
            "url": "{{baseUrl}}/auth/change-password",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"currentPassword\": \"Admin@123\",\n  \"newPassword\": \"NewAdmin@456\"\n}"
            }
          }
        },
        {
          "name": "Refresh Token",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/auth/refresh",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"refreshToken\": \"<your_refresh_token>\"\n}"
            }
          }
        },
        {
          "name": "Logout",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/auth/logout"
          }
        }
      ]
    },
    {
      "name": "👤 Users (Admin)",
      "item": [
        {
          "name": "Create User",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/users",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"New Executive\",\n  \"email\": \"exec2@crm.com\",\n  \"password\": \"Exec@1234\",\n  \"phone\": \"+1111111111\",\n  \"role\": \"sales_executive\"\n}"
            }
          },
          "event": [{
            "listen": "test",
            "script": {
              "exec": [
                "if (pm.response.code === 201) {",
                "  const res = pm.response.json();",
                "  pm.collectionVariables.set('userId', res.data._id);",
                "}"
              ]
            }
          }]
        },
        {
          "name": "Get All Users",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/users?page=1&limit=10&sort=-createdAt&role=sales_executive&isActive=true",
              "query": [
                { "key": "page", "value": "1" },
                { "key": "limit", "value": "10" },
                { "key": "sort", "value": "-createdAt" },
                { "key": "role", "value": "sales_executive" },
                { "key": "isActive", "value": "true" }
              ]
            }
          }
        },
        {
          "name": "Get Users — Search",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/users?search=john",
              "query": [{ "key": "search", "value": "john" }]
            }
          }
        },
        {
          "name": "Get User by ID",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/users/{{userId}}"
          }
        },
        {
          "name": "Update User",
          "request": {
            "method": "PUT",
            "url": "{{baseUrl}}/users/{{userId}}",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Updated Executive Name\",\n  \"phone\": \"+2222222222\"\n}"
            }
          }
        },
        {
          "name": "Deactivate User",
          "request": {
            "method": "PATCH",
            "url": "{{baseUrl}}/users/{{userId}}/deactivate"
          }
        },
        {
          "name": "Activate User",
          "request": {
            "method": "PATCH",
            "url": "{{baseUrl}}/users/{{userId}}/activate"
          }
        },
        {
          "name": "Get Sales Executives",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/users/sales-executives"
          }
        },
        {
          "name": "Delete User",
          "request": {
            "method": "DELETE",
            "url": "{{baseUrl}}/users/{{userId}}"
          }
        }
      ]
    },
